{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dong-rag.local/schemas/retrieval-eval-dataset.json",
  "title": "DongRagRetrievalEvalDataset",
  "description": "离线检索评测集：与 POST /rag/detect/retrieval 请求体对齐（顶层多一层 meta）。",
  "type": "object",
  "required": ["meta", "cases"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["datasetName", "groupId"],
      "additionalProperties": false,
      "properties": {
        "datasetName": { "type": "string", "description": "数据集名称，用于结果文件名" },
        "groupId": { "type": "integer", "minimum": 1 },
        "topK": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "与后端一致，默认 5"
        },
        "includeRerankComparison": {
          "type": "boolean",
          "description": "为 true 且服务端开启 rerank 时返回基线 Hit/MRR"
        },
        "notes": { "type": "string", "description": "简历/报告备注，如数据构造日期" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question"],
        "additionalProperties": false,
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "goldDocumentId": { "type": ["integer", "null"] },
          "goldChunkIndex": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
