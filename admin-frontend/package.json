{
  "name": "admin-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "openapi:generate": "node -e \"fetch('http://localhost:8080/v3/api-docs').then(r=>r.text()).then(t=>require('fs').writeFileSync('openapi.json',t))\" && openapi --input openapi.json --output src/api/generated --client axios"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.15.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.9.1",
    "openapi-typescript-codegen": "^0.30.0",
    "typescript": "~6.0.2",
    "vite": "^5.4.19",
    "vue-tsc": "^3.2.7"
  }
}
